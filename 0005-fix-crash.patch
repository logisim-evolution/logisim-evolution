@@ -114,6 +116,38 @@ class ModernToolbar(private val toolbar: Toolbar) : JPanel(BorderLayout()) {
 
   private var retryScheduled = false
 
+  // ---- tooltips: shown as a regular Swing tooltip popup, so they are never clipped ----------
+  private var tipPopup: Popup? = null
+  private var pendingTip: String? = null
+  private val tipTimer = Timer(600) { showTip() }.apply { isRepeats = false }
+
+  private fun onHover(text: String?, hovered: Boolean) {
+    if (hovered) {
+      hideTip()
+      pendingTip = text
+      if (text.isNullOrBlank()) tipTimer.stop() else tipTimer.restart()
+    } else if (pendingTip == text) {
+      pendingTip = null
+      tipTimer.stop()
+      hideTip()
+    }
+  }
+
+  private fun showTip() {
+    val text = pendingTip ?: return
+    if (!isShowing) return
+    val p = MouseInfo.getPointerInfo()?.location ?: return
+    val tip = createToolTip()
+    tip.tipText = text
+    tipPopup = PopupFactory.getSharedInstance().getPopup(this, tip, p.x + 12, p.y + 20)
+    tipPopup?.show()
+  }
+
+  private fun hideTip() {
+    tipPopup?.hide()
+    tipPopup = null
+  }
+
   /**
    * Model queries can fail while the frame is still being constructed (the old Swing toolbar only
    * asked lazily while painting). Treat failures as "not selected" and retry once the EDT is free.
